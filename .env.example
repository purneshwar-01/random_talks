# Firebase web config — from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL of your deployed /server (see server/README.md). Leave blank to fall back
# to Zego's insecure client-side test-token generator (dev only).
VITE_SERVER_URL=

# Only used as a fallback when VITE_SERVER_URL is blank. Same values as your
# ZegoCloud console. Do NOT rely on this for production — see server/README.md.
VITE_ZEGO_DEV_APP_ID=
VITE_ZEGO_DEV_SERVER_SECRET=
