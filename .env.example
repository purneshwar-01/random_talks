# ==============================================================================
# RandomTalks Pro — Environment Configuration Template
# Copy this file to `.env` in the root directory and populate your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Web Configuration
# Sourced from Firebase Console > Project Settings > General > Your apps (Web)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# Used for real-time AI icebreaker generation and dynamic matchmaking tips.
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# If left blank, the application will automatically fall back to built-in offline
# conversation topic dictionaries.
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=
